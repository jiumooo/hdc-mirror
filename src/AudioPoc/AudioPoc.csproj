<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      M3 音频 POC：验证 PC 能否作为 A2DP Sink 接收手机音频。
      Windows.Media.Audio.AudioPlaybackConnection 于 Windows 10 2004（10.0.19041）
      引入（UniversalApiContract v10 / 655360），因此 TFM 必须 >= 10.0.19041.0
      才能由 csproj 自动投影 WinRT 元数据，无需额外的 Microsoft.Windows.SDK.Contracts。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>

    <RootNamespace>HdcMirror.AudioPoc</RootNamespace>
    <AssemblyName>AudioPoc</AssemblyName>

    <!--
      POC 工程：src/Directory.Build.props 默认把告警升级为错误，
      这里对一次性探针放宽，避免分析器噪声掩盖真正的编译错误。
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CA1416;CS1591;CA1303;CA1305</NoWarn>

    <!-- 控制台需要正常输出中文 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
