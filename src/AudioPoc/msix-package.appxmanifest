<?xml version="1.0" encoding="utf-8"?>
<!--
  AudioPoc 的 MSIX 打包参考清单（不参与编译，仅供「万一需要包身份」时参照）。

  用途说明
  --------
  本次 POC 已实测：普通 Win32 进程（GetCurrentPackageFullName 返回 15700
  APPMODEL_ERROR_NO_PACKAGE）下，AudioPlaybackConnection 的
  GetDeviceSelector() / DeviceInformation.FindAllAsync() / TryCreateFromId() /
  Start() / OpenAsync() 全部可以正常调用，没有出现 UnauthorizedAccessException
  或 0x80070005。也就是说 **A2DP Sink 不需要 MSIX 包身份**。

  因此本文件不是必需品，只是留给将来的一种可能：若某天需要在打包应用里做
  同样的事，或需要声明蓝牙设备访问能力，可照此写。
  它描述的是「打包应用枚举蓝牙设备」的最小 Capabilities 集合。

  关键点
  ------
  1. TargetDeviceFamily 的 MinVersion 必须是 10.0.19041.0 —— AudioPlaybackConnection
     是 UniversalApiContract v10 引入的，低于该版本的设备上该类型根本不存在
     （不是「需要打包」，而是「系统太旧」）。
  2. DeviceCapability Name="bluetooth"：打包应用调用
     DeviceInformation.FindAllAsync 枚举蓝牙设备时需要声明；未打包的 Win32
     进程不受此约束（本次实测已验证）。
  3. 不需要 microphone / webcam / broadFileSystemAccess 之类的额外能力 ——
     AudioPlaybackConnection 只接收、不录音，也不向应用暴露任何 PCM。
  4. 本 POC 用的是 Win32 桌面桥（Desktop Bridge）形态，所以 entry point 指向
     AudioPoc.exe；若改造成 UWP/AppContainer，需要相应调整 Application 元素。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- 这三个值在真实打包时必须替换成自己的值；此处为占位。 -->
  <Identity
    Name="HdcMirror.AudioPoc"
    Publisher="CN=<YOUR_PUBLISHER>"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>HdcMirror AudioPoc</DisplayName>
    <PublisherDisplayName>HdcMirror</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="AudioPoc.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HdcMirror AudioPoc"
        Description="AudioPlaybackConnection 可行性验证"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- 打包应用枚举蓝牙设备所需；本次未打包也成功了，说明它不是 A2DP Sink 的前置条件。 -->
    <DeviceCapability Name="bluetooth" />
    <!-- 桌面桥全信任进程需要，若改 UWP 形态则删除。 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
