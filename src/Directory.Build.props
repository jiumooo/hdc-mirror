<Project>

  <!--
    版本号唯一来源（见 docs/06-命名与仓库信息.md §5）。
    M 里程碑推进时只改这里的 <Version>，csproj / 脚本 / 安装包一律不得重复声明。
  -->
  <PropertyGroup>
    <Version>0.2.2</Version>
    <Product>HdcMirror</Product>
    <Company>HdcMirror</Company>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <!-- 全解决方案统一的编译口径 -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- 0 warning 是 M0 的出口标准之一：任何警告直接拦死 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    卫星资源裁剪（发布体积）：只保留简体中文与英文两套本地化资源。
    不加这条时 publish 目录会带 13 个语言子目录（ru/ja/de/ko/fr/pl/it/es/pt-BR…），
    合计约 15.5MB；本项目只用中英两种语言，其余纯属白送。
    新增语言时在分号分隔的列表里追加即可，例如：zh-Hans;en;ja
    （详细扩展步骤见 docs/19-发布形态与运行时依赖.md）。
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
