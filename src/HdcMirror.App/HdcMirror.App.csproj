<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HdcMirror.App</RootNamespace>
    <!-- 对外名称不带 App 后缀（用户要求）：可执行文件即 HdcMirror.exe -->
    <AssemblyName>HdcMirror</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- L3：默认资源语言固定 zh-CN，缺键时回退到中文而不是空串 -->
    <NeutralResourcesLanguage>zh-CN</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- 2.4.1 起只发 net10.0-windows / net462，net8 会落到 .NET Framework 资产并报 NU1701；2.3.2 是最后一个带 net8.0-windows 的稳定版 -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- 安装包与增量更新：vpk 打包要求主程序调用 VelopackApp.Build().Run() -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HdcMirror.Core\HdcMirror.Core.csproj" />
    <ProjectReference Include="..\HdcMirror.Decode\HdcMirror.Decode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\donate\*.png" />
  </ItemGroup>

  <!-- hdc 随程序分发：构建后落在 <输出>\tools\hdc.exe，HdcLocator 会优先探测这里。
       只用到 hdc 的公共命令（list targets / tconn / shell / fport / file send），不改手机系统组件。 -->
  <ItemGroup>
    <None Include="tools\windows-x64\hdc.exe" Link="tools\hdc.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tools\windows-x64\libusb_shared.dll" Link="tools\libusb_shared.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- 卸载脚本随包发到程序目录（与 exe 平级），用户双击即可卸载并清数据/注册表 -->
  </ItemGroup>

  <!-- 音频子进程 TFM 是 net8.0-windows10.0.19041.0，不能被 net8.0-windows 的工程直接引用；
       用 MSBuild 任务显式先编它，再用下面的 Copy 目标搬产物。 -->
  <!--
    音频接收器是独立进程（只有 net8.0-windows10.0.19041.0 能用 WinRT 的 AudioPlaybackConnection），
    所以不能走 ProjectReference，改为构建时按当前 RID 编译一遍并把产物抄到 <输出>\audio\。
  -->
  <Target Name="BuildAudioSink" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\HdcMirror.Audio\HdcMirror.Audio.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
  </Target>

  <Target Name="CopyAudioSink" AfterTargets="Build">
    <PropertyGroup>
      <_AudioSinkBin>$(MSBuildThisFileDirectory)..\HdcMirror.Audio\bin\$(Configuration)\net8.0-windows10.0.19041.0\</_AudioSinkBin>
      <_AudioSinkBinRid>$(_AudioSinkBin)$(RuntimeIdentifier)\</_AudioSinkBinRid>
    </PropertyGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
      <_AudioSinkFiles Include="$(_AudioSinkBin)**\*.*" Exclude="$(_AudioSinkBin)**\*.pdb" />
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
      <_AudioSinkFiles Include="$(_AudioSinkBinRid)**\*.*" Exclude="$(_AudioSinkBinRid)**\*.pdb" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_AudioSinkFiles)"
      DestinationFolder="$(OutDir)audio\%(RecursiveDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_AudioSinkFiles)' != ''" />
  </Target>

</Project>
