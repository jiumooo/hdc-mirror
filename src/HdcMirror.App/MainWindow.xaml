<ui:FluentWindow
    x:Class="HdcMirror.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.App_Title}"
    Width="440"
    Height="1010"
    MinWidth="400"
    MinHeight="720"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    FontWeight="Medium"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{x:Static ApplicationCommands.Close}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 标题栏右侧窗口按钮：与左侧菜单同为 18px 内边距、32px 高、圆角 6 的悬停底 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停按 Windows 惯例转成红底白字 -->
        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A0251A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- 三段布局：标题栏（菜单 + 窗口按钮）/ 设备栏 / 手机屏幕 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            标题栏：菜单与窗口按钮同排。Header / TrailingContent 位于 WindowChrome 的标题栏命中区，
            不声明 IsHitTestVisibleInChrome 的话点击会被当成拖动标题栏。
        -->
        <ui:TitleBar
            Grid.Row="0"
            Title=""
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <Menu
                    Margin="-29,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                    FontWeight="SemiBold">
                    <Menu.Resources>
                        <!-- 下拉面板用不透明底：默认画刷在 Mica 下是半透明的，文字会糊 -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1B1B1B" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF2F2F2" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0A59F7" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF1B1B1B" />
                    </Menu.Resources>
                    <MenuItem
                        x:Name="MenuApp"
                        Padding="8,0"
                        PreviewMouseLeftButtonDown="OnTopMenuPreviewMouseDown">
                        <Separator />
                        <MenuItem x:Name="MenuAppCheckUpdate" Click="OnMenuCheckUpdateClick" />
                        <MenuItem x:Name="MenuAppAbout" Click="OnMenuAboutClick" />
                        <Separator />
                        <MenuItem
                            x:Name="MenuAppExit"
                            Click="OnMenuExitClick"
 />
                    </MenuItem>

                    <!-- 设置：与其它两个一致，点开下拉；里面的项就是主窗那四个设置页 -->
                    <MenuItem
                        x:Name="MenuSettings"
                        Padding="8,0"
                        PreviewMouseLeftButtonDown="OnTopMenuPreviewMouseDown">
                        <MenuItem Click="OnMenuSettingsTabClick" Header="{x:Static res:Strings.Menu_Settings_Devices}" Tag="devices" />
                        <MenuItem Click="OnMenuSettingsTabClick" Header="{x:Static res:Strings.Menu_Settings_General}" Tag="general" />
                        <MenuItem Click="OnMenuSettingsTabClick" Header="{x:Static res:Strings.Menu_Settings_Keys}" Tag="keys" />
                        <MenuItem Click="OnMenuSettingsTabClick" Header="{x:Static res:Strings.Menu_Settings_Video}" Tag="video" />
                        <MenuItem Click="OnMenuSettingsTabClick" Header="{x:Static res:Strings.Menu_Settings_Audio}" Tag="audio" />
                    </MenuItem>

                    <MenuItem
                        x:Name="MenuHelp"
                        Padding="8,0"
                        PreviewMouseLeftButtonDown="OnTopMenuPreviewMouseDown">
                        <MenuItem Click="OnMenuDocsClick" Header="{x:Static res:Strings.Menu_Help_Docs}" />
                        <MenuItem Click="OnMenuSupportClick" Header="{x:Static res:Strings.Menu_Help_Support}" />
                        <MenuItem Click="OnMenuReportClick" Header="{x:Static res:Strings.Menu_Help_Report}" />
                        <Separator />
                        <MenuItem Click="OnMenuLogFolderClick" Header="{x:Static res:Strings.Menu_Help_LogFolder}" />
                    </MenuItem>
                </Menu>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <!-- 与菜单之间、按钮彼此之间都留出间距（原来紧贴在一起） -->
                <StackPanel
                    Margin="14,0,10,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="OnCaptionMinimize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Minimize}"
                        Content="&#xE921;" />
                    <Button
                        x:Name="CaptionMaximize"
                        Margin="6,0,0,0"
                        Click="OnCaptionMaximize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Maximize}"
                        Content="&#xE922;" />
                    <Button
                        Margin="6,0,0,0"
                        Click="OnCaptionClose"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Close}"
                        Content="&#xE8BB;" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 设备栏：扫描 / 设备选择（收起只显示名称，展开项两行 + 连接或忘记）/ 连接 -->
        <Grid Grid.Row="1" Margin="18,2,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                x:Name="ScanButton"
                Grid.Column="0"
                MinHeight="36"
                Padding="10,0"
                Click="OnScanClick"
                Content="{x:Static res:Strings.Ui_Scan}"
                Icon="{ui:SymbolIcon Symbol=Search24}"
                ToolTip="{x:Static res:Strings.Ui_Scan}" />

            <!-- 自绘下拉：ComboBox 折叠时也会套用 ItemTemplate，无法做到「收起只显示名称、展开两行」 -->
            <Grid Grid.Column="1" Margin="8,0">
                <ui:Button
                    x:Name="DeviceBox"
                    MinHeight="36"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Click="OnDeviceBoxClick"
                    ToolTip="{x:Static res:Strings.Ui_DeviceBoxTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DeviceBoxText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="10"
                            Opacity="0.7"
                            Text="&#xE70D;" />
                    </Grid>
                </ui:Button>

                <Popup
                    x:Name="DevicePopup"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=DeviceBox}"
                    StaysOpen="False"
                    VerticalOffset="4">
                    <Border
                        x:Name="DevicePopupPanel"
                        MaxHeight="320"
                        Padding="6"
                        Background="#FFFFFFFF"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,2"
                                            Padding="8,6"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            MouseLeftButtonUp="OnDeviceRowClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Opacity="0.6"
                                                        Text="{Binding Endpoint}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding ShowEndpoint, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <ui:Button
                                                    Grid.Column="1"
                                                    MinHeight="32"
                                                    Margin="10,0,0,0"
                                                    Padding="12,0"
                                                    VerticalAlignment="Center"
                                                    Appearance="Secondary"
                                                    Background="#FFFDECEC"
                                                    BorderThickness="0"
                                                    Click="OnDeviceItemForgetClick"
                                                    Content="{x:Static res:Strings.Ui_Forget}"
                                                    CornerRadius="6"
                                                    FontSize="12"
                                                    Foreground="#FFB3261E"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />

                                                <ui:Button
                                                    Grid.Column="1"
                                                    MinHeight="32"
                                                    Margin="10,0,0,0"
                                                    Padding="12,0"
                                                    VerticalAlignment="Center"
                                                    Appearance="Primary"
                                                    Click="OnDeviceItemConnectClick"
                                                    Content="{x:Static res:Strings.Ui_Connect}"
                                                    CornerRadius="6"
                                                    FontSize="12"
                                                    Visibility="{Binding IsNotCurrent, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <ui:Button
                x:Name="ConnectButton"
                Grid.Column="2"
                MinHeight="36"
                MinWidth="76"
                Appearance="Primary"
                Click="OnConnectClick"
                Content="{x:Static res:Strings.Ui_Connect}"
                IsEnabled="False" />
        </Grid>

        <!-- 内容区：所有菜单页面都在这一格里就地显示，不弹新窗口 -->
        <Grid x:Name="PhoneArea" Grid.Row="2" Margin="0" SizeChanged="OnPhoneAreaSizeChanged">

            <!-- 内容宿主：设置 / 关于 / 支持作者 / 设备管理都挂到 ManageHost 上 -->
            <Grid
                x:Name="ContentHost"
                Margin="14,0,14,12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal">
                    <ui:Button
                        MinHeight="32"
                        Padding="10,0"
                        Click="OnContentBackClick"
                        Content="{x:Static res:Strings.Ui_Back}"
                        Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                        ToolTip="{x:Static res:Strings.Ui_Back}" />

                    <!--
                        一级分栏：只在设置家族（设备管理 / 通用设置 / 按键映射 / 音画与音频）里出现。
                        帮助里的「支持作者」「使用说明」这类页面不属于设置，进来后整排隐藏，
                        否则会出现「人在支持作者页、下面却挂着设置分栏」的错位。
                    -->
                    <StackPanel
                        x:Name="SettingsTabs"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="TabDevicesButton"
                            MinHeight="32"
                            Margin="6,0,0,0"
                            Padding="10,0"
                        Click="OnContentTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Devices}"
                        FontSize="12"
                        FontWeight="Normal"
                        Tag="devices" />
                    <ui:Button
                        x:Name="TabGeneralButton"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="10,0"
                        Click="OnContentTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_General}"
                        FontSize="12"
                        FontWeight="Normal"
                        Tag="general" />
                    <ui:Button
                        x:Name="TabKeysButton"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="10,0"
                        Click="OnContentTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Keys}"
                        FontSize="12"
                        FontWeight="Normal"
                        Tag="keys" />
                    <ui:Button
                        x:Name="TabVideoButton"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="10,0"
                        Click="OnContentTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Video}"
                        FontSize="12"
                        FontWeight="Normal"
                        Tag="video" />
                    <ui:Button
                        x:Name="TabAudioButton"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="10,0"
                        Click="OnContentTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Audio}"
                        FontSize="12"
                        FontWeight="Normal"
                        Tag="audio" />
                    </StackPanel>
                </StackPanel>

                <Grid
                    x:Name="ManageHost"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    ClipToBounds="True" />
            </Grid>

            <Border
                x:Name="PhoneFrame"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF0B0B0B"
                CornerRadius="30"
                MouseLeftButtonDown="OnPhoneFrameMouseDown"
                RenderTransformOrigin="0,0"
                ToolTip="{x:Static res:Strings.Dev_DoubleClickConnect}">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PhoneScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PhoneShift" X="0" Y="0" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <!--
                        手机屏幕这一层只放「信息 / 空态 / 手动连接」：
                        真正的镜像画面搬到独立的手机窗口（MirrorWindow），点「连接」后才出现。
                    -->

                    <!-- 未连接：手机轮廓 + 提示（不用字形，避免缺字体渲染成方块） -->
                        <Border
                            Padding="20,16"
                            Background="#99000000"
                            CornerRadius="14">
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Border
                            Width="58"
                            Height="104"
                            HorizontalAlignment="Center"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="2"
                            CornerRadius="12">
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="22"
                                    Height="2"
                                    HorizontalAlignment="Center"
                                    Background="#2EFFFFFF"
                                    CornerRadius="1" />
                                <Border
                                    Width="2"
                                    Height="2"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Background="#2EFFFFFF"
                                    CornerRadius="1" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#B4FFFFFF"
                            Text="{x:Static res:Strings.Dev_NoDevice}" />
                        <TextBlock
                            MaxWidth="230"
                            Margin="0,8,0,0"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="#66FFFFFF"
                            Text="{x:Static res:Strings.Dev_NoDeviceHint}" />
                    </StackPanel>
                        </Border>

                    <!-- 已连接：设备信息九项（画面接 M1b 后再叠加） -->
                    <!-- 已连接：设备信息九项，整块在手机屏内垂直居中 -->
                    <StackPanel
                        x:Name="InfoPanel"
                        Margin="20,20,20,20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <StackPanel x:Name="InfoList" />
                    </StackPanel>

                    <!-- 镜像状态浮层：连接中 / 镜像中 · 尺寸 · fps / 失败原因 -->
                    <Border
                        x:Name="MirrorStatusHost"
                        Margin="0,0,0,16"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#99000000"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="MirrorStatusText"
                            FontSize="11"
                            Foreground="#E6FFFFFF" />
                    </Border>
                </Grid>
            </Border>

            <!-- 内容打开时手机屏缩成左下角缩略屏，这行提示告诉用户怎么回去 -->
            <TextBlock
                x:Name="ThumbnailHint"
                Margin="104,0,0,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="11"
                Foreground="#99000000"
                Text="{x:Static res:Strings.Ui_BackToPhone}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</ui:FluentWindow>
