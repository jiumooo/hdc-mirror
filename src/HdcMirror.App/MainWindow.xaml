<ui:FluentWindow
    x:Class="HdcMirror.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.App_Title}"
    Width="440"
    Height="1010"
    MinWidth="400"
    MinHeight="720"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    FontWeight="Medium"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{x:Static ApplicationCommands.Close}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- 标题栏右侧窗口按钮：与左侧菜单同为 18px 内边距、32px 高、圆角 6 的悬停底 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停按 Windows 惯例转成红底白字 -->
        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A0251A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- 三段布局：标题栏（菜单 + 窗口按钮）/ 设备栏 / 手机屏幕 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            标题栏：菜单与窗口按钮同排。Header / TrailingContent 位于 WindowChrome 的标题栏命中区，
            不声明 IsHitTestVisibleInChrome 的话点击会被当成拖动标题栏。
        -->
        <ui:TitleBar
            Grid.Row="0"
            Title=""
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <Menu
                    Margin="-29,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                    FontWeight="SemiBold">
                    <MenuItem x:Name="MenuApp" Padding="8,0">
                        <MenuItem x:Name="MenuAppCheckUpdate" Click="OnMenuCheckUpdateClick" />
                        <MenuItem x:Name="MenuAppAbout" Click="OnMenuAboutClick" />
                        <Separator />
                        <MenuItem
                            x:Name="MenuAppExit"
                            Click="OnMenuExitClick"
                            InputGestureText="Ctrl+Q" />
                    </MenuItem>

                    <MenuItem
                        x:Name="MenuSettings"
                        Padding="8,0">
                        <MenuItem
                            Click="OnMenuDevicesClick"
                            Header="{x:Static res:Strings.Menu_Settings_Devices}" />
                        <MenuItem
                            Click="OnMenuSettingsClick"
                            Header="{x:Static res:Strings.Menu_Settings_General}" />
                        <MenuItem Click="OnMenuKeysClick" Header="{x:Static res:Strings.Menu_Settings_Keys}" />
                        <MenuItem Header="{x:Static res:Strings.Menu_Settings_Av}" IsEnabled="False" />
                    </MenuItem>

                    <MenuItem x:Name="MenuHelp" Padding="8,0">
                        <MenuItem Click="OnMenuDocsClick" Header="{x:Static res:Strings.Menu_Help_Docs}" />
                        <MenuItem Click="OnMenuSupportClick" Header="{x:Static res:Strings.Menu_Help_Support}" />
                        <MenuItem Click="OnMenuReportClick" Header="{x:Static res:Strings.Menu_Help_Report}" />
                        <Separator />
                        <MenuItem Click="OnMenuLogFolderClick" Header="{x:Static res:Strings.Menu_Help_LogFolder}" />
                    </MenuItem>
                </Menu>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <StackPanel
                    Margin="0,0,8,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="OnCaptionMinimize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Minimize}"
                        Content="&#xE921;" />
                    <Button
                        x:Name="CaptionMaximize"
                        Click="OnCaptionMaximize"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Maximize}"
                        Content="&#xE922;" />
                    <Button
                        Click="OnCaptionClose"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Close}"
                        Content="&#xE8BB;" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 设备栏：扫描 / 设备列表（两行：名称 + 地址，每项自带「忘记」按钮）/ 连接 -->
        <Grid Grid.Row="1" Margin="18,2,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                x:Name="ScanButton"
                Grid.Column="0"
                Height="32"
                Padding="10,0"
                Click="OnScanClick"
                Content="{x:Static res:Strings.Ui_Scan}"
                Icon="{ui:SymbolIcon Symbol=Search24}"
                ToolTip="{x:Static res:Strings.Ui_Scan}" />

            <ComboBox
                x:Name="DevicePicker"
                Grid.Column="1"
                Height="32"
                Margin="8,0"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                IsEditable="True"
                IsReadOnly="True"
                TextSearch.TextPath="Name"
                SelectionChanged="OnDeviceSelectionChanged"
                ToolTip="{x:Static res:Strings.Dev_NoDevice}">
                <ComboBox.ItemTemplate>
                    <!-- 展开项：左边上行设备名（略大）+ 下行 IP:端口（小字、灰），右边「忘记」按钮 -->
                    <DataTemplate>
                        <Grid MinWidth="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,2,0,2" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{Binding Endpoint}" />
                            </StackPanel>

                            <!-- 文字按钮而不是图标：SymbolIcon 在这个下拉模板里渲染不出来 -->
                            <Button
                                Grid.Column="1"
                                Height="26"
                                Margin="8,0,0,0"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnForgetDeviceClick"
                                Content="{x:Static res:Strings.Ui_Forget}"
                                FontSize="12"
                                ToolTip="{x:Static res:Strings.Ui_Delete}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ui:Button
                x:Name="ConnectButton"
                Grid.Column="2"
                Height="32"
                MinWidth="76"
                Appearance="Primary"
                Click="OnConnectClick"
                Content="{x:Static res:Strings.Ui_Connect}"
                IsEnabled="False" />
        </Grid>

        <!-- 手机屏幕：等比 1260:2720，圆角黑底，不加大外框，只留 8px 呼吸 -->
        <Grid x:Name="PhoneArea" Grid.Row="2" Margin="0" SizeChanged="OnPhoneAreaSizeChanged">
            <Border
                x:Name="PhoneFrame"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF0B0B0B"
                CornerRadius="30"
                MouseLeftButtonDown="OnPhoneFrameMouseDown"
                ToolTip="{x:Static res:Strings.Dev_DoubleClickConnect}">
                <Grid>
                    <!--
                        手机屏幕这一层只放「信息 / 设备管理」两种内容：
                        真正的镜像画面搬到独立的手机窗口（MirrorWindow），点「连接」后才出现。
                    -->
                    <Grid
                        x:Name="ManageHost"
                        ClipToBounds="True"
                        Visibility="Collapsed" />

                    <!-- 未连接：黑屏 + 提示 -->
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#B4FFFFFF"
                            Text="{x:Static res:Strings.Dev_NoDevice}" />
                        <TextBlock
                            MaxWidth="240"
                            Margin="0,8,0,0"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="#66FFFFFF"
                            Text="{x:Static res:Strings.Dev_NoDeviceHint}" />
                    </StackPanel>

                    <!-- 已连接：设备信息九项（画面接 M1b 后再叠加） -->
                    <!-- 已连接：设备信息九项，整块在手机屏内垂直居中 -->
                    <StackPanel
                        x:Name="InfoPanel"
                        Margin="20,20,20,20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <StackPanel x:Name="InfoList" />
                    </StackPanel>

                    <!--
                        从未连接过任何设备时：手机屏位置直接给出手动连接表单（上下居中）。
                        一旦记住过设备就不再显示，改由上方设备栏 / 设备管理页操作。
                    -->
                    <StackPanel
                        x:Name="ManualPanel"
                        Margin="26,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#CCFFFFFF"
                            Text="{x:Static res:Strings.Dev_ManualTitle}" />
                        <TextBlock
                            Margin="0,8,0,16"
                            FontSize="12"
                            Foreground="#70FFFFFF"
                            Text="{x:Static res:Strings.Dev_ManualHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <ui:TextBox
                            x:Name="ManualIpBox"
                            Height="34"
                            PlaceholderText="{x:Static res:Strings.Dev_ManualIpPlaceholder}" />
                        <ui:TextBox
                            x:Name="ManualPortBox"
                            Height="34"
                            Margin="0,10,0,0"
                            PlaceholderText="{x:Static res:Strings.Dev_ManualPortPlaceholder}" />
                        <ui:Button
                            Margin="0,16,0,0"
                            Height="34"
                            Appearance="Primary"
                            Click="OnManualConnectFromScreenClick"
                            Content="{x:Static res:Strings.Dev_ManualConnect}" />
                    </StackPanel>

                    <!-- 镜像状态浮层：连接中 / 镜像中 · 尺寸 · fps / 失败原因 -->
                    <Border
                        x:Name="MirrorStatusHost"
                        Margin="0,0,0,16"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#99000000"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="MirrorStatusText"
                            FontSize="11"
                            Foreground="#E6FFFFFF" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
