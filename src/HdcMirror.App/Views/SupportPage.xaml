<UserControl
    x:Class="HdcMirror.App.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 支持作者：页面内两块按钮，点哪个显示哪个收款码 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,124">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Supporter_Title}" />

            <TextBlock
                Margin="0,6,0,14"
                FontSize="12"
                Opacity="0.7"
                Text="{x:Static res:Strings.Supporter_Note}"
                TextWrapping="Wrap" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="AlipayButton"
                    MinWidth="112"
                    Height="36"
                    Margin="0,0,10,0"
                    Appearance="Primary"
                    Click="OnAlipayClick"
                    Content="{x:Static res:Strings.Supporter_Alipay}" />
                <ui:Button
                    x:Name="WeChatButton"
                    MinWidth="112"
                    Height="36"
                    Appearance="Secondary"
                    Click="OnWeChatClick"
                    Content="{x:Static res:Strings.Supporter_WeChat}" />
            </StackPanel>

            <Border
                Margin="0,14,0,0"
                Padding="10"
                HorizontalAlignment="Center"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="12">
                <Image
                    x:Name="QrImage"
                    Width="232"
                    Height="232"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="Uniform" />
            </Border>

            <TextBlock
                Margin="0,18,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Static res:Strings.Supporter_ListTitle}" />

            <Border
                Padding="16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    Text="{x:Static res:Strings.Supporter_Empty}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>