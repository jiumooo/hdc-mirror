<UserControl
    x:Class="HdcMirror.App.Views.AvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,196">
            <TextBlock FontSize="20" FontWeight="Bold" Text="{x:Static res:Strings.Menu_Settings_Audio}" />
            <TextBlock Margin="0,6,0,14" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_AudioRoleHint}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_AudioReceive}" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button x:Name="AudioToggleButton" MinHeight="32" MinWidth="96" Click="OnAudioToggleClick" Content="{x:Static res:Strings.Settings_AudioStart}" />
                        <ui:Button MinHeight="32" Margin="8,0,0,0" Padding="12,0" Click="OnOpenSoundSettingsClick" Content="{x:Static res:Strings.Settings_AudioOpenSound}" />
                    </StackPanel>

                    <TextBlock x:Name="AudioStateText" Margin="0,10,0,0" FontSize="12" Text="{x:Static res:Strings.Settings_AudioState_Idle}" TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Settings_AudioOutput}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ComboBox x:Name="OutputDeviceBox" Width="220" MinHeight="36" VerticalAlignment="Center" SelectionChanged="OnOutputDeviceChanged" VerticalContentAlignment="Center" />
                            <ui:Button MinHeight="32" Margin="8,0,0,0" Padding="12,0" Click="OnRefreshDevicesClick" Content="{x:Static res:Strings.Ui_Refresh}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{x:Static res:Strings.Settings_AudioOutputHint}" />

                    <CheckBox x:Name="AutoAudioBox" Margin="0,14,0,0" Checked="OnAutoAudioChanged" Content="{x:Static res:Strings.Settings_AutoAudio}" FontSize="13" Unchecked="OnAutoAudioChanged" />

                    <TextBlock Margin="0,14,0,0" FontSize="12" LineHeight="20" Opacity="0.75" Text="{x:Static res:Strings.Settings_AudioSteps}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>