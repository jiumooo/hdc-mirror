<UserControl
    x:Class="HdcMirror.App.Views.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,196">
            <TextBlock FontSize="20" FontWeight="Bold" Text="{x:Static res:Strings.Menu_Settings_Video}" />
            <TextBlock Margin="0,6,0,14" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_EffectiveHint}" TextWrapping="Wrap" />

            <!--  画质  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_Quality}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Settings_Preset}" />
                        </StackPanel>
                        <ComboBox x:Name="PresetBox" Grid.Column="1" MinHeight="36" VerticalAlignment="Center" SelectionChanged="OnPresetChanged" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="{x:Static res:Strings.Preset_Ultra}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Preset_High}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Preset_Balanced2}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Preset_Smooth}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Preset_Custom}" />
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="PresetDetail" Margin="0,8,0,0" FontSize="11" Opacity="0.72" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{x:Static res:Strings.Settings_PresetHint}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Settings_FrameRate}" />
                            <TextBlock x:Name="FrameRateDetail" Margin="0,2,0,0" FontSize="11" Opacity="0.72" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.6" Text="{x:Static res:Strings.Settings_FrameRateHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="FrameRateBox" Grid.Column="1" MinHeight="36" VerticalAlignment="Center" SelectionChanged="OnFrameRateChanged" VerticalContentAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Settings_BitRate}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.6" Text="{x:Static res:Strings.Settings_BitRateHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="BitRateBox" Grid.Column="1" MinHeight="36" VerticalAlignment="Center" SelectionChanged="OnBitRateChanged" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="24" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  锁屏画面：定时抓手机屏幕当背景  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_LockShot}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_LockShotTip}" TextWrapping="Wrap" />

                    <CheckBox x:Name="LockShotBox" Margin="0,14,0,0" Checked="OnLockShotChanged" Content="{x:Static res:Strings.Settings_LockShotAuto}" FontSize="13" Unchecked="OnLockShotChanged" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button MinHeight="32" MinWidth="96" Click="OnCaptureNowClick" Content="{x:Static res:Strings.Settings_LockShotNow}" />
                        <TextBlock x:Name="LockShotText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  操作手感：快速甩动开关  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_SwipeFast}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_SwipeFastHint}" TextWrapping="Wrap" />

                    <CheckBox x:Name="SwipeFastBox" Margin="0,12,0,0" Checked="OnSwipeFastChanged" Content="{x:Static res:Strings.Settings_SwipeFast}" FontSize="13" Unchecked="OnSwipeFastChanged" />
                </StackPanel>
            </Border>

            <!--  应用专属滑动：视频/短剧类应用改发原生 swipe  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_NativeApps}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_NativeAppsHint}" TextWrapping="Wrap" />

                    <TextBox x:Name="NativeAppsBox" Margin="0,12,0,0" MinHeight="36" LostFocus="OnNativeAppsCommit" VerticalContentAlignment="Center" />

                    <!--  名单逐行显示，每行带删除按钮  -->
                    <StackPanel x:Name="NativeAppsList" Margin="0,8,0,0" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button MinHeight="32" Click="OnNativeAppsUseCurrent" Content="{x:Static res:Strings.Settings_NativeAppsUseCurrent}" />
                        <TextBlock x:Name="NativeAppsText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  当前前台应用：显示手机正在用的应用，一键加进上面的专属滑动名单  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_ForegroundApp}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" Text="{x:Static res:Strings.Settings_ForegroundAppHint}" TextWrapping="Wrap" />

                    <TextBlock x:Name="ForegroundAppText" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_ForegroundAppUnknown}" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button MinHeight="32" MinWidth="96" Click="OnForegroundAppRefresh" Content="{x:Static res:Strings.Settings_ForegroundAppRefresh}" />
                        <ui:Button Margin="8,0,0,0" MinHeight="32" Click="OnForegroundAppAdd" Content="{x:Static res:Strings.Settings_NativeAppsUseCurrent}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SavedText" Margin="0,12,0,0" FontSize="12" Opacity="0" Text="{x:Static res:Strings.Settings_EffectiveHint}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
