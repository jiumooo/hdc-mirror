<UserControl
    x:Class="HdcMirror.App.Views.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,20">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Keys_Title}" />
            <TextBlock
                Margin="0,6,0,14"
                FontSize="12"
                Opacity="0.7"
                Text="{x:Static res:Strings.Keys_Desc}"
                TextWrapping="Wrap" />

            <Border
                Padding="16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="{x:Static res:Strings.Keys_Col_Key}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="{x:Static res:Strings.Keys_Col_Action}" />
                    </Grid>

                    <StackPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_Esc}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_EscAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_Home}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_HomeAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_Recents}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_RecentsAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_Power}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_PowerAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_VolumeUp}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_VolumeUpAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_VolumeDown}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_VolumeDownAction}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Text="{x:Static res:Strings.Keys_Editing}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Opacity="0.85"
                                Text="{x:Static res:Strings.Keys_EditingAction}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
