<UserControl
    x:Class="HdcMirror.App.Views.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}" Margin="20,10,20,196">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Menu_Settings_Keys}" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="13"
                Opacity="0.72"
                Text="{x:Static res:Strings.Keys_MapTip}"
                TextWrapping="Wrap" />

            <!--  映射行由 KeysPage.xaml.cs 动态生成：没有任何预设  -->
            <StackPanel x:Name="RowsHost" Margin="0,14,0,0" />

            <StackPanel
                Margin="0,14,0,0"
                Orientation="Horizontal">
                <ui:Button
                    MinHeight="32"
                    MinWidth="104"
                    Click="OnAddClick"
                    Content="{x:Static res:Strings.Keys_Add}" />
                <ui:Button
                    MinHeight="32"
                    Margin="8,0,0,0"
                    MinWidth="104"
                    Appearance="Primary"
                    Click="OnSaveClick"
                    Content="{x:Static res:Strings.Keys_Save}" />
                <TextBlock
                    x:Name="SavedText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.75" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
