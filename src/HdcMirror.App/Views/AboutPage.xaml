<UserControl     x:Class="HdcMirror.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources">

    <!-- M0 占位页。M6 计划：
         版本号（已在此页读取程序集信息）、构建时间、.NET 运行时版本、
         第三方组件与许可证清单、日志目录快捷入口、检查更新按钮。 -->
    <StackPanel Margin="24">
        <TextBlock
            FontSize="28"
            FontWeight="Bold"
            Text="{x:Static res:Strings.Nav_About}" />
        <TextBlock
            Margin="0,16,0,0"
            FontSize="14"
            Text="{x:Static res:Strings.Nav_About_FullName}" />
        <TextBlock
            x:Name="VersionText"
            Margin="0,4,0,0"
            FontSize="13" />
        <TextBlock
            Margin="0,16,0,0"
            FontSize="13"
            Text="{x:Static res:Strings.Nav_About_Description}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
