<UserControl
    x:Class="HdcMirror.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,16">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Nav_About}" />

            <TextBlock
                Margin="0,14,0,0"
                FontSize="16"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Nav_About_FullName}" />
            <TextBlock
                x:Name="VersionText"
                Margin="0,4,0,0"
                FontSize="13"
                Opacity="0.75" />
            <TextBlock
                Margin="0,12,0,0"
                FontSize="13"
                LineHeight="20"
                Text="{x:Static res:Strings.Nav_About_Description}"
                TextWrapping="Wrap" />

            <!-- 项目仓库：整行可点，点了用默认浏览器打开 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.About_RepoSection}" />
                    <Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        MinHeight="32"
                        Padding="12,0"
                        Click="OnRepoClick"
                        Cursor="Hand"
                        ToolTip="{x:Static res:Strings.About_RepoUrlHint}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon VerticalAlignment="Center" Symbol="Link24" FontSize="14" />
                            <TextBlock
                                x:Name="RepoUrlText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{x:Static res:Strings.About_RepoUrl}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{x:Static res:Strings.About_RepoHint}" />
                </StackPanel>
            </Border>

            <!-- 反馈 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.About_FeedbackSection}" />
                    <Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        MinHeight="32"
                        Padding="12,0"
                        Click="OnIssuesClick"
                        Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon VerticalAlignment="Center" Symbol="Chat24" FontSize="14" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{x:Static res:Strings.Menu_Help_Report}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{x:Static res:Strings.About_FeedbackHint}" />
                </StackPanel>
            </Border>

            <!-- 许可与第三方 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.About_LicenseSection}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        LineHeight="20"
                        Text="{x:Static res:Strings.About_LicenseBody}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>