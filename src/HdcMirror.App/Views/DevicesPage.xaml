<UserControl     x:Class="HdcMirror.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources">

    <!-- M0 占位页。M4 计划：
         上方「设备卡片列表」——每张卡片圆角 8，间距 16，含状态圆点（已连接/连接中/已断开）、
         地址文本（由用户配置提供，不在源码里写死任何地址）、最近连接时间、主操作按钮；
         空态给「手动输入地址」入口与一段说明文字；
         底部工具条放刷新与批量断开。 -->
    <StackPanel Margin="24">
        <TextBlock
            FontSize="28"
            FontWeight="Bold"
            Text="{x:Static res:Strings.Nav_Devices}" />
        <TextBlock
            Margin="0,8,0,0"
            FontSize="13"
            Text="{x:Static res:Strings.Nav_Devices_Description}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
