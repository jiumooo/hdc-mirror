<ui:FluentWindow
    x:Class="HdcMirror.App.Views.LanguageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.Lang_DialogTitle}"
    Width="420"
    Height="260"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题与说明故意双语：此刻还不知道用户要哪种语言  -->
        <ui:TitleBar
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False"
            Title="{x:Static res:Strings.Lang_DialogTitle}" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ui:Button
                x:Name="ChineseButton"
                Height="42"
                HorizontalAlignment="Stretch"
                Click="OnChineseClick"
                Content="{x:Static res:Strings.Lang_Chinese}" />
            <ui:Button
                x:Name="EnglishButton"
                Height="42"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Click="OnEnglishClick"
                Content="{x:Static res:Strings.Lang_English}" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,14,0,0"
            FontSize="12"
            Opacity="0.72"
            Text="{x:Static res:Strings.Lang_DialogHint}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
