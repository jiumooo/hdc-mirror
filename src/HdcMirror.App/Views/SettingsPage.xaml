<UserControl
    x:Class="HdcMirror.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Menu_Settings_General}" />

            <TextBlock
                Margin="0,6,0,14"
                FontSize="12"
                Opacity="0.7"
                Text="{x:Static res:Strings.Settings_EffectiveHint}"
                TextWrapping="Wrap" />

            <!--  行为  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Settings_Behavior}" />
                    <CheckBox
                        x:Name="CloseToTrayBox"
                        Margin="0,14,0,0"
                        Checked="OnCloseToTrayChanged"
                        Content="{x:Static res:Strings.Settings_CloseToTray}"
                        FontSize="13"
                        Unchecked="OnCloseToTrayChanged" />
                </StackPanel>
            </Border>
            <!--  启动与扫描  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Settings_Section_Startup}" />
                    <CheckBox
                        x:Name="AutoScanBox"
                        Margin="0,14,0,0"
                        Checked="OnAutoScanChanged"
                        Content="{x:Static res:Strings.Settings_AutoScan}"
                        FontSize="13"
                        Unchecked="OnAutoScanChanged" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{x:Static res:Strings.Settings_AutoScanHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  界面语言  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Settings_Language}" />
                    <ComboBox
                        x:Name="LanguageBox"
                        Margin="0,14,0,0"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="{x:Static res:Strings.Lang_System}" Tag="" />
                        <ComboBoxItem Content="{x:Static res:Strings.Lang_Chinese}" Tag="zh-Hans" />
                        <ComboBoxItem Content="{x:Static res:Strings.Lang_English}" Tag="en" />
                    </ComboBox>
                    <TextBlock
                        Style="{StaticResource FieldHintStyle}"
                        Text="{x:Static res:Strings.Settings_LanguageHint}" />
                </StackPanel>
            </Border>

            <!--  本机数据  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Static res:Strings.Settings_Section_Data}" />
                    <ui:Button
                        x:Name="OpenDataFolderButton"
                        Margin="0,14,0,0"
                        Height="32"
                        Click="OnOpenDataFolderClick"
                        Content="{x:Static res:Strings.Settings_OpenDataFolder}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{x:Static res:Strings.Settings_DataFolderHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>


            <TextBlock
                x:Name="SavedText"
                Margin="0,12,0,0"
                FontSize="12"
                Opacity="0"
                Text="{x:Static res:Strings.Settings_EffectiveHint}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
