<UserControl
    x:Class="HdcMirror.App.Views.DeviceManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontSize="13">

    <!--
        内容自上而下排布；底部留 132px 空白，给左下角那块 84px 的手机缩略屏让位，
        避免手填地址框和按钮被缩略屏压住。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}" Margin="20,10,20,132">

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                Opacity="0.7"
                Text="{x:Static res:Strings.DevMgr_Saved}" />

            <!--  已记住的设备：两行（名称大、地址小）+ 连接 / 删除  -->
            <ItemsControl x:Name="SavedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,6"
                            Padding="10,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ui:Button
                                    Grid.Column="1"
                                    MinHeight="32"
                                    Margin="6,0,0,0"
                                    Padding="10,0"
                                    Appearance="Primary"
                                    Click="OnSavedConnectClick"
                                    Content="{x:Static res:Strings.DevMgr_Connect}" />

                                <Button
                                    Grid.Column="2"
                                    MinHeight="32"
                                    Margin="6,0,0,0"
                                    Padding="8,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnSavedDeleteClick"
                                    Content="{x:Static res:Strings.DevMgr_Delete}"
                                    FontSize="12"
                                    Opacity="0.7" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                x:Name="EmptyHint"
                Margin="0,6,0,0"
                FontSize="12"
                Opacity="0.55"
                Text="{x:Static res:Strings.DevMgr_Empty}"
                TextWrapping="Wrap" />

            <!--  手动连接：IP 单独一行给足宽度，端口与按钮放下一行，避免窄面板里被截断  -->
            <TextBlock
                Margin="0,16,0,6"
                FontSize="12"
                Opacity="0.7"
                Text="{x:Static res:Strings.DevMgr_Manual}" />
            <ui:TextBox
                x:Name="IpBox"
                MinHeight="36"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                PlaceholderText="{x:Static res:Strings.DevMgr_IpPlaceholder}" VerticalContentAlignment="Center" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    x:Name="PortBox"
                    Grid.Column="0"
                    MinHeight="36"
                    Margin="0,0,8,0"
                    PlaceholderText="{x:Static res:Strings.DevMgr_PortPlaceholder}" VerticalContentAlignment="Center" />

                <ui:Button
                    Grid.Column="1"
                    MinHeight="32"
                    HorizontalAlignment="Right"
                    Padding="14,0"
                    Appearance="Primary"
                    Click="OnManualConnectClick"
                    Content="{x:Static res:Strings.DevMgr_Connect}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
