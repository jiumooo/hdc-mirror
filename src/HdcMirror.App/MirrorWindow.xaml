<Window
    x:Class="HdcMirror.App.MirrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.App_Title}"
    Width="470"
    Height="1015"
    MinWidth="340"
    MinHeight="360"
    Background="#FF0B0B0B"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    FontWeight="Medium"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <!-- 控制条上的窗口按钮：34×26、圆角 6、悬停浅灰底；关闭键悬停转红 -->
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最近任务：圆角正方形（26×26、圆角 7、细描边），与相邻按钮同高 -->
        <Style x:Key="BarSquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0,2,0" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 置顶图钉：选中（IsChecked）时保持高亮 -->
        <Style x:Key="BarPinButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC0A84FF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BarCloseButtonStyle"
            BasedOn="{StaticResource BarButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A0251A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 覆盖层页签：浅色文字 + 圆角悬停，和主窗口的设置分栏一致 -->
        <Style x:Key="OverlayTabStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
        控制条一律固定在窗口上方横排：横屏（设备转成横屏、窗口变宽）时不再旋转、
        也不再移到右侧，避免里面的文字躺倒。一份布局同时服务横竖屏。
    -->
    <DockPanel x:Name="Shell" LastChildFill="True">
        <Border
            x:Name="ControlBar"
            Height="32"
            Padding="6,0,6,0"
            Background="#F21C1C1C"
            BorderBrush="#1AFFFFFF"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid x:Name="BarContent">
                <Grid.ColumnDefinitions>
                    <!-- 设备名占 * 列：窗口变窄时先缩名字（末尾省略），功能键与三个窗口按钮永不挤压 -->
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#E6FFFFFF"
                    TextTrimming="CharacterEllipsis" />

                <!-- 置顶图钉：紧跟手机名称，选中即窗口 Topmost -->
                <ToggleButton
                    x:Name="PinButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Checked="OnPinChecked"
                    Content="&#xE718;"
                    Style="{StaticResource BarPinButtonStyle}"
                    ToolTip="{x:Static res:Strings.Ui_Pin}"
                    Unchecked="OnPinChecked" />

                <!-- 窗口内页面入口：不再弹新窗口，改为缩小画面 + 覆盖层。
                     用户要求：设备管理 / 设置合并成一个「设置」，点开就是四页签覆盖层。 -->
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="2"
                    Click="OnSettingsPageClick"
                    Content="&#xE713;"
                    Style="{StaticResource BarButtonStyle}"
                    ToolTip="{x:Static res:Strings.Ui_PageSettings}" />

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <!-- 系统功能键：走 uitest keyEvent（uinput 对 Home/Back/Power 是假成功）。
                         顺序按用户要求：返回 → 主桌面 → 多任务。 -->
                    <Button
                        x:Name="BackButton"
                        Click="OnKeyBackClick"
                        Content="&#xE72B;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyBack}" />
                    <Button
                        x:Name="HomeButton"
                        Click="OnKeyHomeClick"
                        Content="&#xE80F;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyHome}" />
                    <Button
                        x:Name="RecentButton"
                        Click="OnKeyRecentClick"
                        Content="&#xE81C;"
                        Style="{StaticResource BarSquareButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyRecent}" />
                </StackPanel>

                <!-- 音频：把手机声音接到电脑（蓝牙 A2DP Sink，独立子进程负责） -->
                <Button
                    x:Name="AudioButton"
                    Grid.Column="4"
                    Click="OnAudioToggleClick"
                    Content="&#xE767;"
                    Style="{StaticResource BarButtonStyle}"
                    ToolTip="{x:Static res:Strings.Ui_Audio}" />

                <!-- 窗口按钮：最小化 / 最大化 / 关闭。用户明确要求这三个永远不隐藏，单独成列不被挤压 -->
                <StackPanel
                    Grid.Column="5"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Click="OnMinimizeClick"
                        Content="&#xE921;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Minimize}" />
                    <Button
                        x:Name="MaximizeButton"
                        Click="OnMaximizeClick"
                        Content="&#xE922;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Maximize}" />
                    <Button
                        Click="OnCloseClick"
                        Content="&#xE8BB;"
                        Style="{StaticResource BarCloseButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画面区 -->
        <Grid
            x:Name="ScreenHost"
            Background="#FF0B0B0B"
            ClipToBounds="True">

            <!-- 页面覆盖层：在缩小的虚拟屏“下面”一层，供设备管理 / 设置等内容使用 -->
            <Grid x:Name="OverlayHost" Background="#FF121212" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="14,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="OverlayTitle"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#F2FFFFFF"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Click="OnOverlayCloseClick"
                        Content="&#xE711;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_PageClose}" />
                </Grid>

                <!-- 页签：与主窗口四个设置页一一对应，主窗口加什么这里就能看到什么 -->
                <StackPanel
                    x:Name="OverlayTabs"
                    Grid.Row="1"
                    Margin="14,0,14,8"
                    Orientation="Horizontal">
                    <Button
                        x:Name="OverlayTabDevices"
                        Tag="devices"
                        Click="OnOverlayTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Devices}"
                        Style="{StaticResource OverlayTabStyle}" />
                    <Button
                        x:Name="OverlayTabGeneral"
                        Tag="general"
                        Click="OnOverlayTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_General}"
                        Style="{StaticResource OverlayTabStyle}" />
                    <Button
                        x:Name="OverlayTabKeys"
                        Tag="keys"
                        Click="OnOverlayTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Keys}"
                        Style="{StaticResource OverlayTabStyle}" />
                    <Button
                        x:Name="OverlayTabAv"
                        Tag="av"
                        Click="OnOverlayTabClick"
                        Content="{x:Static res:Strings.Menu_Settings_Av}"
                        Style="{StaticResource OverlayTabStyle}" />
                </StackPanel>

                <ContentControl
                    x:Name="PageHost"
                    Grid.Row="2"
                    Margin="12,2,12,10" />
            </Grid>

            <!--
                虚拟屏幕：四角圆角裁剪（Clip 在代码里按实际尺寸生成），
                画面用 UniformToFill 铺满，多出的部分裁掉，不留上下黑边。
            -->
            <Border
                x:Name="ScreenFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#FF0B0B0B"
                ClipToBounds="True"
                CornerRadius="10">
                <Grid x:Name="FrameSurface" ClipToBounds="True">
                    <Image
                        x:Name="ScreenImage"
                        SnapsToDevicePixels="True"
                        Stretch="UniformToFill" />

                    <!-- 未开始镜像时的锁屏画面 + 毛玻璃信息层 -->
                    <Grid x:Name="IdleHost">
                        <Border Background="#FF101218" />
                        <Image x:Name="IdleBackdrop" SnapsToDevicePixels="True" Stretch="UniformToFill">
                            <Image.Effect>
                                <BlurEffect
                                    KernelType="Gaussian"
                                    Radius="26"
                                    RenderingBias="Performance" />
                            </Image.Effect>
                        </Image>
                        <!-- 半透明黑遮罩：毛玻璃的“磨砂”那一层 -->
                        <Border Background="#99000000" />

                        <ScrollViewer
                            Margin="18,22,18,22"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="IdleInfoPanel">
                                <StackPanel.Effect>
                                    <DropShadowEffect
                                        BlurRadius="14"
                                        Opacity="0.9"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </StackPanel.Effect>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#F2FFFFFF"
                                    Text="{x:Static res:Strings.Ui_InfoTitle}" />
                                <StackPanel
                                    x:Name="IdleInfoList"
                                    Margin="0,14,0,0" />
                                <TextBlock
                                    x:Name="IdleHint"
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="#B3FFFFFF"
                                    Text="{x:Static res:Strings.Ui_IdleHint}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 连接中 / 镜像中（左下角：无线/有线 · fps） / 空闲 -->
            <Border
                x:Name="StatusHost"
                Margin="14,0,0,14"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#99000000"
                CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <!-- 有线 / 无线标识 -->
                    <TextBlock
                        x:Name="LinkText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#B3FFFFFF" />
                    <TextBlock
                        x:Name="LinkDot"
                        Margin="6,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#66FFFFFF"
                        Text="·" />
                    <!-- 连接中显示转圈：纯视觉，不参与布局计算 -->
                    <ui:ProgressRing
                        x:Name="StatusSpinner"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#E6FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
