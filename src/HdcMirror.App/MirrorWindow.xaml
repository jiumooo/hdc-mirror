<Window
    x:Class="HdcMirror.App.MirrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.App_Title}"
    Width="470"
    Height="1015"
    MinWidth="260"
    MinHeight="360"
    Background="#FF0B0B0B"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    FontWeight="Medium"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <!-- 控制条上的窗口按钮：32×26、圆角 6、悬停浅灰底；关闭键悬停转红 -->
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BarCloseButtonStyle"
            BasedOn="{StaticResource BarButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A0251A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        控制条用 DockPanel：竖屏 Dock 到上边，横屏 Dock 到右边并把内容整体旋转 90°，
        这样同一份控件在两种朝向下都保持可读，不用维护两套。
    -->
    <DockPanel x:Name="Shell" LastChildFill="True">
        <Border
            x:Name="ControlBar"
            Height="32"
            Padding="6,0,6,0"
            Background="#F21C1C1C"
            BorderBrush="#1AFFFFFF"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid x:Name="BarContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#E6FFFFFF"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    x:Name="ZoomText"
                    Grid.Column="1"
                    Margin="8,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#99FFFFFF" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <!-- 系统功能键：走 uitest keyEvent（uinput 对 Home/Back/Power 是假成功） -->
                    <Button
                        x:Name="HomeButton"
                        Click="OnKeyHomeClick"
                        Content="&#xE80F;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyHome}" />
                    <Button
                        x:Name="BackButton"
                        Click="OnKeyBackClick"
                        Content="&#xE72B;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyBack}" />
                    <Button
                        x:Name="RecentButton"
                        Click="OnKeyRecentClick"
                        Content="&#xE81C;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyRecent}" />
                    <Button
                        x:Name="PowerButton"
                        Click="OnKeyPowerClick"
                        Content="&#xE7E8;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_KeyPower}" />
                    <!-- 音频：把手机声音接到电脑（蓝牙 A2DP Sink，独立子进程负责） -->
                    <Button
                        x:Name="AudioButton"
                        Click="OnAudioToggleClick"
                        Content="&#xE767;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ui_Audio}" />
                    <Button
                        Click="OnMinimizeClick"
                        Content="&#xE921;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Minimize}" />
                    <Button
                        x:Name="MaximizeButton"
                        Click="OnMaximizeClick"
                        Content="&#xE922;"
                        Style="{StaticResource BarButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Maximize}" />
                    <Button
                        Click="OnCloseClick"
                        Content="&#xE8BB;"
                        Style="{StaticResource BarCloseButtonStyle}"
                        ToolTip="{x:Static res:Strings.Tip_Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画面区：Image 严格按帧尺寸显示，窗口比例由代码锁定，所以不会被拉变形 -->
        <Grid
            x:Name="ScreenHost"
            Background="#FF0B0B0B"
            ClipToBounds="True">
            <Image x:Name="ScreenImage" SnapsToDevicePixels="True" Stretch="Fill" />

            <!-- 连接中 / 镜像中 · 尺寸 · fps / 空闲 -->
            <Border
                x:Name="StatusHost"
                Margin="0,0,0,14"
                Padding="10,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#99000000"
                CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <!-- 连接中显示转圈：纯视觉，不参与布局计算 -->
                    <ui:ProgressRing
                        x:Name="StatusSpinner"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#E6FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
