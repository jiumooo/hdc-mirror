<Window
    x:Class="HdcMirror.App.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:HdcMirror.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.Confirm_DeleteTitle}"
    Width="400"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    FontWeight="Medium"
    ResizeMode="NoResize"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:SymbolIcon
                Width="20"
                Height="20"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Foreground="#C42B1C"
                Symbol="Warning24" />
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="Bold" />
        </StackPanel>

        <TextBlock
            x:Name="BodyText"
            Grid.Row="1"
            Margin="30,10,0,0"
            FontSize="13"
            LineHeight="20"
            Opacity="0.85"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="CancelButton"
                MinWidth="80"
                Height="32"
                Click="OnCancelClick"
                Content="{x:Static res:Strings.Ui_Cancel}" />
            <ui:Button
                x:Name="OkButton"
                MinWidth="80"
                Height="32"
                Margin="8,0,0,0"
                Appearance="Danger"
                Click="OnOkClick"
                Content="{x:Static res:Strings.Confirm_DeleteOk}" />
        </StackPanel>
    </Grid>
</Window>
