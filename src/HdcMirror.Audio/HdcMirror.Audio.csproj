<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 需要 WinRT 投影（Windows.Media.Audio.AudioPlaybackConnection 自 10.0.19041 起提供） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HdcMirror.Audio</RootNamespace>
    <AssemblyName>HdcMirror.Audio</AssemblyName>
    <!-- 用软件自己的图标：否则 Windows 音量合成器里会显示默认的音频设备图标（一个麦克风）。 -->
    <ApplicationIcon>..\HdcMirror.App\Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 主程序共用 RID 构建：publish -r win-x64 时也要能产出 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
